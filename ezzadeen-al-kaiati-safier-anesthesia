<script>
/* Accessibility-friendly language switch + auto-detect */
(function(){
  const btn = document.getElementById('langBtn');
  const label = document.getElementById('langLabel');
  const sections = Array.from(document.querySelectorAll('.content'));
  function setLang(lang){
    document.documentElement.lang = lang;
    document.documentElement.dir = (lang==='ar') ? 'rtl' : 'ltr';
    sections.forEach(s=> s.style.display = (s.getAttribute('data-lang')===lang) ? 'block' : 'none' );
    if(lang==='ar'){
      document.getElementById('nameLine').textContent = 'إزّادين ';
      document.getElementById('subLine').textContent = 'منشئ محتوى • مُعلم • مهندس';
      document.getElementById('descLine').textContent = 'تعليم طبي ومشروعات صيانة سيارات — خطوة بخطوة، مبنية لتُعاد تجربتها.';
      label.textContent = 'English';
      btn.setAttribute('aria-pressed','true');
    } else {
      document.getElementById('nameLine').innerHTML = 'Ezzadeen <i style="font-style:normal;color:var(--accent-g)">Hadi</i>';
      document.getElementById('subLine').textContent = 'CONTENT CREATOR • EDUCATOR • ENGINEER';
      document.getElementById('descLine').textContent = 'Medical education & automotive DIY projects — crafted step by step, built to be replicated.';
      label.textContent = 'العربية';
      btn.setAttribute('aria-pressed','false');
    }
  }
  const nav = navigator.language || 'en';
  setLang(nav.startsWith('ar') ? 'ar' : 'en');
  btn.addEventListener('click', ()=> setLang(document.documentElement.lang==='ar' ? 'en' : 'ar'));
  window.addEventListener('keydown', (e)=>{ if(e.altKey && (e.key==='l' || e.key==='L')) btn.click(); });
})();

/* Capture helpers */
async function cloneForCapture(sourceElem, widthPx, heightPx){
  const clone = sourceElem.cloneNode(true);
  clone.style.transform = 'none';
  clone.style.width = widthPx + 'px';
  clone.style.height = heightPx + 'px';
  clone.style.position = 'absolute';
  clone.style.left = '-99999px';
  clone.style.top = '0';
  clone.classList.remove('preview-mini','scale-yt','scale-fb');
  clone.querySelectorAll('.preview-mini, .scale-yt, .scale-fb').forEach(n=>{ n.classList.remove('preview-mini','scale-yt','scale-fb'); n.style.transform='none'; n.style.width='100%'; n.style.height='100%'; });
  document.getElementById('fullContainers').appendChild(clone);
  await document.fonts.ready;
  return clone;
}

async function captureCanvasFromElement(elem, width, height, format='png', quality=0.92){
  const canvas = await html2canvas(elem, {
    width: width,
    height: height,
    scale: 1,
    useCORS: true,
    backgroundColor: null,
    allowTaint: true
  });
  if(format === 'webp'){
    return canvas.toDataURL('image/webp', quality);
  }
  return canvas.toDataURL('image/png');
}

function downloadDataUrl(dataUrl, filename){
  const a = document.createElement('a');
  a.href = dataUrl;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
}

/* Specific capture functions */
async function captureAndDownload(previewId, filename, width, height, tag){
  try{
    const preview = document.getElementById(previewId);
    const clone = await cloneForCapture(preview, width, height);
    const banner = clone.querySelector('.yt-banner, .fb-banner') || clone;
    const dataUrl = await captureCanvasFromElement(banner, width, height, 'png');
    downloadDataUrl(dataUrl, filename);
    clone.remove();
  } catch(err){
    alert('Capture failed: ' + err.message);
    console.error(err);
  }
}

async function captureAndDownloadWebP(previewId, filename, width, height, tag){
  try{
    const preview = document.getElementById(previewId);
    const clone = await cloneForCapture(preview, width, height);
    const banner = clone.querySelector('.yt-banner, .fb-banner') || clone;
    const dataUrl = await captureCanvasFromElement(banner, width, height, 'webp', 0.92);
    downloadDataUrl(dataUrl, filename);
    clone.remove();
  } catch(err){
    alert('WebP capture failed: ' + err.message);
    console.error(err);
  }
}

async function captureAndDownloadPDF(previewId, filename, width, height, tag){
  try{
    const preview = document.getElementById(previewId);
    const clone = await cloneForCapture(preview, width, height);
    const banner = clone.querySelector('.yt-banner, .fb-banner') || clone;
    // render PNG first
    const dataUrl = await captureCanvasFromElement(banner, width, height, 'png');
    // convert to PDF using jsPDF
    const { jsPDF } = window.jspdf;
    // set orientation based on width>height
    const orientation = width > height ? 'landscape' : 'portrait';
    const pdf = new jsPDF({ orientation: orientation, unit: 'px', format: [width, height] });
    pdf.addImage(dataUrl, 'PNG', 0, 0, width, height);
    const blob = pdf.output('blob');
    saveAs(blob, filename);
    clone.remove();
  } catch(err){
    alert('PDF generation failed: ' + err.message);
    console.error(err);
  }
}

/* open full-size view */
async function openFull(previewId, width, height){
  const preview = document.getElementById(previewId);
  if(!preview){ alert('Preview not found'); return; }
  const clone = await cloneForCapture(preview, width, height);
  const banner = clone.querySelector('.yt-banner, .fb-banner') || clone;
  const dataUrl = await captureCanvasFromElement(banner, width, height, 'png');
  const win = window.open();
  if(win){
    win.document.write('<title>Banner preview</title><img src="'+dataUrl+'" alt="Banner preview" style="max-width:100%;height:auto;display:block;margin:0">');
    win.document.close();
  } else {
    downloadDataUrl(dataUrl, 'banner.png');
  }
  clone.remove();
}

/* ZIP all banners (PNG + WebP + PDF + LICENSE.txt) */
document.getElementById('downloadAll').addEventListener('click', async ()=>{
  const tasks = [
    {id:'ytGold', name:'yt_gold', w:2560, h:1440},
    {id:'ytTeal', name:'yt_teal', w:2560, h:1440},
    {id:'fbGold', name:'fb_gold', w:1640, h:624},
    {id:'fbTeal', name:'fb_teal', w:1640, h:624},
  ];
  const zip = new JSZip();
  try{
    for(const t of tasks){
      const preview = document.getElementById(t.id);
      if(!preview) continue;
      const clone = await cloneForCapture(preview, t.w, t.h);
      const banner = clone.querySelector('.yt-banner, .fb-banner') || clone;
      const png = await captureCanvasFromElement(banner, t.w, t.h, 'png');
      const webp = await captureCanvasFromElement(banner, t.w, t.h, 'webp', 0.92);
      // add PNG and WebP
      zip.file(t.name + '.png', png.split(',')[1], {base64:true});
      zip.file(t.name + '.webp', webp.split(',')[1], {base64:true});
      // create PDF using jsPDF (small, using canvas blob)
      // For simplicity, add PNG as PDF page (server-side conversion recommended for best results)
      const pdfBlob = await (async ()=>{
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: t.w>t.h ? 'landscape' : 'portrait', unit: 'px', format: [t.w, t.h] });
        pdf.addImage(png, 'PNG', 0, 0, t.w, t.h);
        const blob = pdf.output('blob');
        return blob;
      })();
      const arrayBuf = await pdfBlob.arrayBuffer();
      zip.file(t.name + '.pdf', arrayBuf);
      clone.remove();
      await new Promise(r=>setTimeout(r, 300)); // small pause
    }
    // LICENSE + README inside ZIP
    zip.file('LICENSE.txt', 'Copyright (c) 2025 Ezzadeen Hadi. Use assets with attribution or contact owner for commercial use.');
    zip.file('README.txt', 'Contains banners in PNG, WebP and PDF. Use safe zone guides for mobile display.');
    const content = await zip.generateAsync({type:'blob'});
    saveAs(content, 'ezzadeenhadi_banners.zip');
  } catch(err){
    alert('Failed to create ZIP: ' + err.message);
    console.error(err);
  }
});

/* openAll: sequentially open each full-size (user gesture may be blocked in some browsers) */
document.getElementById('openAll').addEventListener('click', ()=>{
  const list = [
    {id:'ytGold', w:2560, h:1440},
    {id:'ytTeal', w:2560, h:1440},
    {id:'fbGold', w:1640, h:624},
    {id:'fbTeal', w:1640, h:624}
  ];
  (async ()=>{
    for(const item of list){
      await openFull(item.id, item.w, item.h);
      await new Promise(r=>setTimeout(r, 600));
    }
  })();
});
</script>

